# d4st environment configuration
# Copy to .env and fill in values

# PostgreSQL password
D4ST_DB_PASSWORD=changeme_to_something_secure

# Database connection string (for non-Docker installs)
# D4ST_DATABASE_URL=postgresql://d4st:password@localhost:5432/d4st

# API keys (comma-separated). Leave empty to disable auth (dev only).
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
D4ST_API_KEYS=

# Egress allowlist (comma-separated public IPs). The verify layer FAILS CLOSED
# unless the observed public egress IP is in this list. Forked from ASM-NG.
D4ST_VERIFY_EGRESS_IPS=

# interactsh (OAST / blind-vuln callbacks). Leave empty to use the default hosted
# server; set to a self-hosted interactsh-server URL for in-network operation.
D4ST_INTERACTSH_SERVER=

# Optional: ASM-NG wire-in. If set, findings are POSTed to this ASM-NG REST API.
# D4ST_ASMNG_API_URL=
# D4ST_ASMNG_API_KEY=

# Scope carve-out: path exclusion from INTRUSIVE testing (safety-critical).
# Comma-separated regex / glob / substring path patterns. Matching endpoints NEVER receive an
# intrusive / state-changing / form-submitting request (not even under the 'aggressive' policy or
# fuzz_forms=True) — but they ARE still passively GET-crawled so they appear in the sitemap.
# Use for endpoints whose mere invocation has real-world side effects (e.g. an archiver whose
# "create capture/site/crawl" makes the server fetch an arbitrary external URL).
# Pattern forms (matched against the URL PATH *and* QUERY STRING, case-insensitive; also matched
# after percent-decoding and dot-segment collapse, so /api%2Fcapture and ?do=capture are caught):
#   re:<python-regex>  -> regex, matched anywhere in path+query
#   *capture*          -> glob (fnmatch over the whole path+query) when it contains * ? [ ]
#   /capture           -> plain substring match (no metacharacters); matches /api/v2/capture/new
# NOTE a glob matches the WHOLE path+query, so '/api/*/capture*' needs a middle segment and will
# NOT match '/api/capture' — use a substring ('/capture') or '*capture*' to catch both.
# A malformed re: pattern ABORTS the run (fail-closed), it never silently disables the carve-out.
# Example: exclude every create/capture/crawl/archive route (path- or query-routed):
# D4ST_EXCLUDE_PATHS=/capture,*capture*,/crawl,re:[?&]do=(capture|crawl|archive),re:/(create|new)-(site|capture|crawl)\b,/archive
D4ST_EXCLUDE_PATHS=

# Session-validity self-test MODE (fail-closed gate run before an authenticated engagement).
#   rendered   (DEFAULT) : rendered headless-browser probe for a logged-in portal-cookie marker
#                          (e.g. a /accounts/logout link). Correct for cookie/session web apps.
#   basic-auth           : the engagement authenticates with HTTP Basic Auth (Authorization
#                          header), NOT a portal cookie. Validate by proving the configured Basic
#                          creds GATE the endpoint: a no-auth request is rejected (401) and the
#                          Basic-auth request is authorized (2xx). Anything else ABORTS (a no-auth
#                          200 = auth not required, a with-auth non-2xx = creds rejected).
#   both                 : rendered AND basic-auth must both pass.
# Leaving this unset keeps the exact legacy behavior. A basic-auth/both mode with the three
# fields below missing ABORTS the run (fail-closed — the gate is never silently skipped).
D4ST_SESSION_VALIDITY_MODE=rendered
# Endpoint for the basic-auth probe (an authenticated API route that answers 401 unauthenticated).
# D4ST_SESSION_VALIDITY_URL=
# Basic-Auth credentials (email/username : password) replayed in the probe's Authorization header.
# D4ST_BASIC_AUTH_USER=
# D4ST_BASIC_AUTH_PASS=
