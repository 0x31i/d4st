# d4st environment configuration
# Copy to .env and fill in values

# PostgreSQL password
D4ST_DB_PASSWORD=changeme_to_something_secure

# Database connection string (for non-Docker installs)
# D4ST_DATABASE_URL=postgresql://d4st:password@localhost:5432/d4st

# API keys (comma-separated). Leave empty to disable auth (dev only).
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
D4ST_API_KEYS=

# Egress allowlist (comma-separated public IPs). The verify layer FAILS CLOSED
# unless the observed public egress IP is in this list. Forked from ASM-NG.
D4ST_VERIFY_EGRESS_IPS=

# interactsh (OAST / blind-vuln callbacks). Leave empty to use the default hosted
# server; set to a self-hosted interactsh-server URL for in-network operation.
D4ST_INTERACTSH_SERVER=

# Optional: ASM-NG wire-in. If set, findings are POSTed to this ASM-NG REST API.
# D4ST_ASMNG_API_URL=
# D4ST_ASMNG_API_KEY=

# Scope carve-out: path exclusion from INTRUSIVE testing (safety-critical).
# Comma-separated regex / glob / substring path patterns. Matching endpoints NEVER receive an
# intrusive / state-changing / form-submitting request (not even under the 'aggressive' policy or
# fuzz_forms=True) — but they ARE still passively GET-crawled so they appear in the sitemap.
# Use for endpoints whose mere invocation has real-world side effects (e.g. an archiver whose
# "create capture/site/crawl" makes the server fetch an arbitrary external URL).
# Pattern forms (matched against the URL path, case-insensitive):
#   re:<python-regex>  -> regex, matched anywhere in the path
#   /api/capture*      -> glob (fnmatch) when it contains * ? [ ]
#   /capture           -> plain substring match (no metacharacters)
# Example: exclude every create/capture/crawl/archive route:
# D4ST_EXCLUDE_PATHS=/capture,/api/*/capture*,/crawl,re:/(create|new)-(site|capture|crawl)\b,/archive
D4ST_EXCLUDE_PATHS=
