# dast-ng environment configuration
# Copy to .env and fill in values

# PostgreSQL password
DASTNG_DB_PASSWORD=changeme_to_something_secure

# Database connection string (for non-Docker installs)
# DASTNG_DATABASE_URL=postgresql://dastng:password@localhost:5432/dastng

# API keys (comma-separated). Leave empty to disable auth (dev only).
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASTNG_API_KEYS=

# Egress allowlist (comma-separated public IPs). The verify layer FAILS CLOSED
# unless the observed public egress IP is in this list. Forked from ASM-NG.
DASTNG_VERIFY_EGRESS_IPS=

# interactsh (OAST / blind-vuln callbacks). Leave empty to use the default hosted
# server; set to a self-hosted interactsh-server URL for in-network operation.
DASTNG_INTERACTSH_SERVER=

# Optional: ASM-NG wire-in. If set, findings are POSTed to this ASM-NG REST API.
# DASTNG_ASMNG_API_URL=
# DASTNG_ASMNG_API_KEY=
